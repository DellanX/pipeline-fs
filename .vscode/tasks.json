{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-ui",
            "type": "shell",
            "command": "npm",
            "args": ["run", "build"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new"
            },
            "options": {
                "cwd": "${workspaceFolder}/ui"
            }
        },
        {
            "label": "run-ui-dev",
            "type": "shell",
            "command": "npm",
            "args": ["run", "dev"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new"
            },
            "options": {
                "cwd": "${workspaceFolder}/ui"
            }
        },
        {
            "label": "run-ui-preview",
            "type": "shell",
            "command": "npm",
            "args": ["run", "preview"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new"
            },
            "options": {
                "cwd": "${workspaceFolder}/ui"
            }
        },
        {
            "label": "build-rust-service",
            "type": "shell",
            "command": "cargo",
            "args": ["build"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "run-rust-service",
            "type": "shell",
            "command": "${workspaceFolder}/target/debug/pipeline-fs",
            "args": [
                "--mount-point",
                "/tmp/test-mount",
                "--stages",
                "/tmp/stage0",
                "/tmp/stage1",
                "--port",
                "8080"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "run-rust-service-dev",
            "type": "shell",
            "command": "cargo",
            "args": ["run"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "run-all",
            "type": "shell",
            "command": "/workspaces/pipeline-fs/scripts/run-all.sh",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new"
            }
        }
    ]
}